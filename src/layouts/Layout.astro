---
import {SITE_NAME,SITE_TAGLINE,absoluteUrl} from "../lib/site";
const {title=SITE_NAME,description=SITE_TAGLINE,image,canonical,noindex=false}=Astro.props;
const site=Astro.locals.runtime?.env?.SITE_URL||"https://viralwire.pages.dev";
const pageTitle=title===SITE_NAME?SITE_NAME:title+" — "+SITE_NAME;
const canonicalUrl=canonical||absoluteUrl(Astro.url.pathname,site);
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{pageTitle}</title><meta name="description" content={description}>
{noindex&&<meta name="robots" content="noindex,nofollow">}<link rel="canonical" href={canonicalUrl}>
<meta property="og:type" content="website"><meta property="og:site_name" content={SITE_NAME}><meta property="og:title" content={pageTitle}><meta property="og:description" content={description}><meta property="og:url" content={canonicalUrl}>
{image&&<meta property="og:image" content={image}>}<meta name="twitter:card" content={image?"summary_large_image":"summary"}><meta name="twitter:title" content={pageTitle}><meta name="twitter:description" content={description}>{image&&<meta name="twitter:image" content={image}>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="alternate" type="application/rss+xml" title="VIRALWIRE RSS" href="/rss.xml">
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--bg:#08090c;--panel:#101218;--line:#242832;--text:#f5f7fa;--muted:#8d95a5;--accent:#ff3d81;--accent2:#7c5cff;--max:1240px}
*{box-sizing:border-box}html{background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% -10%,rgba(124,92,255,.14),transparent 32%),radial-gradient(circle at 10% 20%,rgba(255,61,129,.07),transparent 28%),var(--bg)}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{width:min(calc(100% - 32px),var(--max));margin:auto}.muted{color:var(--muted)}.topline{height:3px;background:linear-gradient(90deg,var(--accent),var(--accent2))}.header{position:sticky;top:0;z-index:20;background:rgba(8,9,12,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.06)}.nav{height:76px;display:flex;align-items:center;gap:26px}.logo{font-family:"Space Grotesk";font-weight:900;font-size:25px;letter-spacing:-1.4px}.logo span{color:var(--accent)}.navlinks{display:flex;gap:20px;align-items:center;flex:1}.navlinks a{font-size:13px;font-weight:700;color:#b8beca}.navlinks a:hover{color:#fff}.search{width:230px;height:40px;border:1px solid var(--line);background:#0e1015;border-radius:12px;padding:0 14px;color:#fff;outline:none}.menu{display:none;background:none;border:0;color:#fff;font-size:22px}.section{padding:34px 0}.eyebrow{text-transform:uppercase;letter-spacing:1.8px;font-size:11px;font-weight:900;color:var(--accent)}.hero-grid{display:grid;grid-template-columns:1.65fr 1fr;gap:18px}.hero{position:relative;min-height:510px;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#111}.hero img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.92),rgba(0,0,0,.05) 70%)}.hero-content{position:absolute;z-index:2;left:30px;right:30px;bottom:28px}.hero h1{font-family:"Space Grotesk";font-size:clamp(34px,5vw,66px);line-height:.96;letter-spacing:-2.8px;max-width:850px;margin:12px 0}.hero p{max-width:760px;color:#c5cad4;line-height:1.6;margin:0}.side-list{display:grid;gap:18px}.story-card{border:1px solid var(--line);background:linear-gradient(145deg,#11141b,#0e1015);border-radius:18px;overflow:hidden;display:grid;grid-template-columns:145px 1fr;min-height:145px}.story-card img{width:100%;height:100%;min-height:145px;object-fit:cover}.story-card-body{padding:18px}.story-card h3{font-family:"Space Grotesk";font-size:20px;line-height:1.08;margin:7px 0}.story-card p{font-size:13px;line-height:1.5;color:var(--muted);margin:0}.meta{display:flex;gap:9px;align-items:center;color:#858d9b;font-size:11px;text-transform:uppercase;letter-spacing:.7px;font-weight:800}.pill{padding:5px 8px;border-radius:7px;background:rgba(255,61,129,.1);color:#ff75a5}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.section-head h2{font-family:"Space Grotesk";font-size:30px;margin:5px 0;letter-spacing:-1px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.tile{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--panel);transition:.2s}.tile:hover{transform:translateY(-3px);border-color:#383d49}.tile img{width:100%;aspect-ratio:16/9;object-fit:cover}.tile-body{padding:18px}.tile h3{font-family:"Space Grotesk";font-size:21px;line-height:1.08;margin:8px 0}.tile p{color:var(--muted);font-size:13px;line-height:1.55;margin:0}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);background:#151820;color:#fff;border-radius:10px;padding:10px 14px;font-weight:800;font-size:13px;cursor:pointer}.btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));border:0}.article{max-width:900px;margin:auto}.article-head{padding:55px 0 28px}.article h1{font-family:"Space Grotesk";font-size:clamp(40px,6vw,72px);line-height:.98;letter-spacing:-3px;margin:12px 0 20px}.dek{font-size:20px;line-height:1.5;color:#aeb5c1}.cover{width:100%;max-height:620px;object-fit:cover;border-radius:22px;border:1px solid var(--line)}.prose{font-size:18px;line-height:1.82;color:#d5d9e0;padding-top:30px}.prose h2{font-family:"Space Grotesk";font-size:31px;line-height:1.1;margin-top:46px}.prose p{margin:0 0 24px}.prose blockquote{margin:36px 0;padding:22px 26px;border-left:3px solid var(--accent);background:#101219;color:#fff;font-family:"Space Grotesk";font-size:23px;line-height:1.4}.sharebar{display:flex;gap:10px;flex-wrap:wrap;margin:28px 0}.trend-row{display:grid;grid-template-columns:70px 1fr auto;gap:18px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}.rank{font-family:"Space Grotesk";font-size:35px;color:#4b5260;font-weight:900}.trend-row h3{margin:0 0 5px;font-family:"Space Grotesk";font-size:22px}.trend-row p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.views{font-weight:800;color:#aeb5c1;font-size:12px}.footer{border-top:1px solid var(--line);margin-top:60px;padding:38px 0;color:var(--muted);font-size:12px}.footer-grid{display:flex;justify-content:space-between;gap:30px}.ad-slot{margin:18px 0;text-align:center}.panel{background:#101218;border:1px solid var(--line);border-radius:16px;padding:20px}.admin-shell{min-height:100vh;background:#0b0d11}.admin-nav{border-bottom:1px solid var(--line);padding:16px 0}.admin-grid{display:grid;grid-template-columns:220px 1fr;gap:24px;padding:30px 0}.admin-side{border:1px solid var(--line);border-radius:16px;background:#101218;padding:12px;height:max-content}.admin-side a{display:block;padding:11px 12px;border-radius:9px;color:#aeb5c1;font-size:13px;font-weight:700}.admin-side a:hover{background:#191c24;color:#fff}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:12px;color:#9ba3b2;font-weight:800}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);background:#0b0d11;color:#fff;border-radius:9px;padding:11px 12px;outline:none}.field textarea{min-height:130px;resize:vertical}.toolbar{display:flex;flex-wrap:wrap;gap:6px;border:1px solid var(--line);border-bottom:0;background:#171a21;padding:8px;border-radius:9px 9px 0 0}.toolbar button{background:#0e1015;border:1px solid var(--line);color:#c8cdd7;border-radius:6px;padding:7px 9px;cursor:pointer}.editor{min-height:420px;border:1px solid var(--line);background:#0b0d11;border-radius:0 0 9px 9px;padding:18px;outline:none;line-height:1.7}.admin-table{width:100%;border-collapse:collapse}.admin-table th,.admin-table td{text-align:left;padding:13px 10px;border-bottom:1px solid var(--line);font-size:12px}.status{font-size:10px;text-transform:uppercase;font-weight:900;padding:5px 7px;border-radius:6px;background:#1b2029}.status.published{background:rgba(47,209,122,.1);color:#6ee7a6}.login{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(430px,100%);border:1px solid var(--line);border-radius:20px;background:#101218;padding:28px}@media(max-width:900px){.navlinks{display:none}.menu{display:block}.search{width:180px}.hero-grid{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.admin-grid{grid-template-columns:1fr}.admin-side{display:flex;gap:5px;overflow:auto}.admin-side a{white-space:nowrap}}@media(max-width:620px){.wrap{width:min(calc(100% - 22px),var(--max))}.nav{height:64px;gap:10px}.logo{font-size:22px}.search{width:145px;height:36px}.grid{grid-template-columns:1fr}.story-card{grid-template-columns:110px 1fr}.story-card img{min-height:125px}.story-card-body{padding:13px}.story-card h3{font-size:17px}.hero{min-height:430px;border-radius:16px}.hero-content{left:18px;right:18px;bottom:20px}.article-head{padding:35px 0 20px}.article h1{letter-spacing:-2px}.prose{font-size:17px}.footer-grid{display:grid}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.trend-row{grid-template-columns:42px 1fr}.views{display:none}}
</style></head><body><div class="topline"></div><header class="header"><div class="wrap nav"><a class="logo" href="/">VIRAL<span>WIRE</span></a><nav class="navlinks"><a href="/">Home</a><a href="/trending">Trending</a><a href="/category/x-stories">X Stories</a><a href="/category/tech-ai">Tech & AI</a><a href="/category/entertainment">Entertainment</a></nav><form action="/search" method="get"><input class="search" name="q" placeholder="Search stories..." aria-label="Search stories"></form><button class="menu" aria-label="Menu">☰</button></div></header><main><slot /></main><footer class="footer"><div class="wrap footer-grid"><div><strong style="color:#fff">VIRALWIRE</strong><br>{SITE_TAGLINE}</div><div><a href="/trending">Trending</a> · <a href="/rss.xml">RSS</a> · <a href="/admin">Admin</a></div></div></footer></body></html>