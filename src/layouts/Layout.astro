---
import {SITE_NAME,SITE_TAGLINE,absoluteUrl} from "../lib/site";
import {getLocale,localeNames,locales,localePath,t} from "../lib/i18n";
import {getPublishedStories} from "../lib/db";
import NewsTicker from "../components/NewsTicker.astro";

const {title=SITE_NAME,description=SITE_TAGLINE,image,canonical,noindex=false}=Astro.props;
const site=Astro.locals.runtime?.env?.SITE_URL||"https://viralwire.pulserapp.com";
const locale=getLocale(Astro.locals);
const path=Astro.url.pathname;
const pathParts=path.split("/").filter(Boolean);
if(pathParts.length&&locales.includes(pathParts[0] as typeof locale)) pathParts.shift();
const basePath="/"+pathParts.join("/");
const localizedCanonical=localePath(locale,basePath==="/"?"/":basePath);
const canonicalUrl=canonical||absoluteUrl(localizedCanonical,site);
const langAlternates=locales.map(code=>({code,url:absoluteUrl(localePath(code,basePath==="/"?"/":basePath),site)}));
const imageUrl=image?absoluteUrl(image,site):undefined;
const pageTitle=title===SITE_NAME?SITE_NAME:title+" — "+SITE_NAME;

const tickerStories=await getPublishedStories(Astro.locals,12);
---
<!doctype html>
<html lang={locale} data-theme="dark">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{pageTitle}</title><meta name="description" content={description}>
{noindex&&<meta name="robots" content="noindex,nofollow">}<link rel="canonical" href={canonicalUrl}>
{langAlternates.map(a=><link rel="alternate" hreflang={a.code} href={a.url}/>)}
<link rel="alternate" hreflang="x-default" href={absoluteUrl(basePath,site)}/>
<meta property="og:type" content="website"><meta property="og:site_name" content={SITE_NAME}><meta property="og:title" content={pageTitle}><meta property="og:description" content={description}><meta property="og:url" content={canonicalUrl}>
{imageUrl&&<><meta property="og:image" content={imageUrl}><meta property="og:image:alt" content={pageTitle}></>}<meta name="twitter:card" content={imageUrl?"summary_large_image":"summary"}><meta name="twitter:title" content={pageTitle}><meta name="twitter:description" content={description}>{imageUrl&&<meta name="twitter:image" content={imageUrl}>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="alternate" type="application/rss+xml" title="VIRALWIRE RSS" href="/rss.xml">
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--bg:#08090c;--panel:#101218;--panel2:#151820;--line:#242832;--text:#f5f7fa;--muted:#8d95a5;--accent:#ff3d81;--accent2:#7c5cff;--max:1240px;--header:rgba(8,9,12,.88)}
html[data-theme="light"]{--bg:#f4f6fa;--panel:#fff;--panel2:#f0f2f6;--line:#dfe3eb;--text:#11131a;--muted:#667085;--header:rgba(244,246,250,.88)}
*{box-sizing:border-box}html{background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;transition:background .2s,color .2s}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% -10%,rgba(124,92,255,.14),transparent 32%),radial-gradient(circle at 10% 20%,rgba(255,61,129,.07),transparent 28%),var(--bg)}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{width:min(calc(100% - 32px),var(--max));margin:auto}.muted{color:var(--muted)}.topline{height:3px;background:linear-gradient(90deg,var(--accent),var(--accent2))}.header{position:sticky;top:0;z-index:20;background:var(--header);backdrop-filter:blur(18px);border-bottom:1px solid rgba(127,135,150,.15)}.nav{height:76px;display:flex;align-items:center;gap:20px}.logo{font-family:"Space Grotesk";font-weight:900;font-size:25px;letter-spacing:-1.4px;white-space:nowrap}.logo span{color:var(--accent)}.navlinks{display:flex;gap:20px;align-items:center;flex:1}.navlinks a{font-size:13px;font-weight:700;color:var(--muted);white-space:nowrap}.navlinks a:hover{color:var(--text)}.search{width:210px;height:40px;border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:0 14px;color:var(--text);outline:none}.search::placeholder{color:var(--muted)}.google-translate{height:40px;display:flex;align-items:center;padding:0 8px;border:1px solid var(--line);background:var(--panel);border-radius:11px;color:var(--text);font-size:12px;overflow:hidden}.google-translate .goog-te-gadget{font-family:Inter,system-ui,sans-serif!important;font-size:0!important}.google-translate .goog-te-gadget-simple{background:transparent!important;border:0!important;padding:0!important;font-size:11px!important;line-height:38px!important}.google-translate .goog-te-gadget-simple img{display:none}.google-translate .goog-te-menu-value{color:var(--text)!important}.google-translate .goog-te-menu-value span{color:var(--text)!important}.google-translate .goog-te-banner-frame{display:none!important}.theme-toggle{width:40px;height:40px;border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:11px;cursor:pointer;display:grid;place-items:center;font-size:17px}.theme-toggle .sun{display:none}.menu{display:none;background:none;border:0;color:var(--text);font-size:22px}.utility{border-bottom:1px solid rgba(127,135,150,.13);background:color-mix(in srgb,var(--panel) 72%,transparent)}.utility-inner{display:grid;grid-template-columns:minmax(0,1fr) auto;min-height:42px;align-items:center;gap:18px}.ticker{display:flex;align-items:center;min-width:0;overflow:hidden}.ticker-label{height:25px;display:flex;align-items:center;gap:7px;padding-right:13px;margin-right:13px;border-right:1px solid var(--line);font-size:10px;font-weight:900;letter-spacing:1.1px;color:var(--accent);white-space:nowrap}.live-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px rgba(255,61,129,.1);animation:pulse 1.7s infinite}.ticker-viewport{overflow:hidden;white-space:nowrap;min-width:0}.ticker-track{display:flex;align-items:center;width:max-content;gap:0;will-change:transform;animation:tickerMove 42s linear infinite}.ticker-group{display:flex;align-items:center;gap:34px;flex:none;padding-right:34px}.ticker:hover .ticker-track{animation-play-state:paused}.ticker-item{display:inline-flex;align-items:center;gap:9px;font-size:12px;font-weight:700;color:var(--text);flex:none}.ticker-item:hover{color:var(--accent)}.ticker-category{font-size:9px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);font-weight:900}.weather{display:flex;align-items:center;gap:11px;white-space:nowrap;font-size:11px}.weather-icon{font-size:19px;line-height:1}.weather-main{font-weight:900;font-size:12px}.weather-meta{color:var(--muted);font-size:10px;margin-top:2px}.weather-place{color:var(--text);font-weight:700}.weather-loading{color:var(--muted)}@keyframes tickerMove{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}@keyframes pulse{50%{opacity:.45;transform:scale(.82)}}.section{padding:34px 0}.eyebrow{text-transform:uppercase;letter-spacing:1.8px;font-size:11px;font-weight:900;color:var(--accent)}.hero-grid{display:grid;grid-template-columns:1.65fr 1fr;gap:18px}.hero{position:relative;min-height:390px;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#111}.hero img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.92),rgba(0,0,0,.05) 70%)}.hero-content{position:absolute;z-index:2;left:26px;right:26px;bottom:24px}.hero h1{font-family:"Space Grotesk";font-size:clamp(30px,4vw,52px);line-height:.96;letter-spacing:-2.8px;max-width:850px;margin:12px 0}.hero p{max-width:680px;color:#c5cad4;line-height:1.5;margin:0;font-size:14px}.side-list{display:grid;gap:18px}.story-card{border:1px solid var(--line);background:linear-gradient(145deg,var(--panel),var(--panel2));border-radius:18px;overflow:hidden;display:grid;grid-template-columns:145px 1fr;min-height:145px}.story-card img{width:100%;height:100%;min-height:145px;object-fit:cover}.story-card-body{padding:18px}.story-card h3{font-family:"Space Grotesk";font-size:20px;line-height:1.08;margin:7px 0}.story-card p{font-size:13px;line-height:1.5;color:var(--muted);margin:0}.meta{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.7px;font-weight:800}.pill{padding:5px 8px;border-radius:7px;background:rgba(255,61,129,.1);color:#ff75a5}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.section-head h2{font-family:"Space Grotesk";font-size:30px;margin:5px 0;letter-spacing:-1px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.tile{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--panel);transition:.2s}.tile:hover{transform:translateY(-3px);border-color:#8a91a0}.tile img{width:100%;aspect-ratio:16/9;object-fit:cover}.tile-body{padding:18px}.tile h3{font-family:"Space Grotesk";font-size:21px;line-height:1.08;margin:8px 0}.tile p{color:var(--muted);font-size:13px;line-height:1.55;margin:0}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:10px;padding:10px 14px;font-weight:800;font-size:13px;cursor:pointer}.btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));border:0;color:#fff}.article{max-width:900px;margin:auto}.article-head{padding:55px 0 28px}.article h1{font-family:"Space Grotesk";font-size:clamp(40px,6vw,72px);line-height:.98;letter-spacing:-3px;margin:12px 0 20px}.dek{font-size:20px;line-height:1.5;color:var(--muted)}.cover{width:100%;max-height:620px;object-fit:cover;border-radius:22px;border:1px solid var(--line)}.prose{font-size:18px;line-height:1.82;color:var(--text);padding-top:30px}.prose h2{font-family:"Space Grotesk";font-size:31px;line-height:1.1;margin-top:46px}.prose p{margin:0 0 24px}.prose blockquote{margin:36px 0;padding:22px 26px;border-left:3px solid var(--accent);background:var(--panel);color:var(--text);font-family:"Space Grotesk";font-size:23px;line-height:1.4}.sharebar{display:flex;gap:10px;flex-wrap:wrap;margin:28px 0}.trend-row{display:grid;grid-template-columns:70px 1fr auto;gap:18px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}.rank{font-family:"Space Grotesk";font-size:35px;color:var(--muted);font-weight:900}.trend-row h3{margin:0 0 5px;font-family:"Space Grotesk";font-size:22px}.trend-row p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.views{font-weight:800;color:var(--muted);font-size:12px}.footer{border-top:1px solid var(--line);margin-top:60px;padding:38px 0;color:var(--muted);font-size:12px}.footer-grid{display:flex;justify-content:space-between;gap:30px}.ad-slot{margin:18px 0;text-align:center}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}.admin-shell{min-height:100vh;background:var(--bg)}.admin-nav{border-bottom:1px solid var(--line);padding:16px 0}.admin-grid{display:grid;grid-template-columns:220px 1fr;gap:24px;padding:30px 0}.admin-side{border:1px solid var(--line);border-radius:16px;background:var(--panel);padding:12px;height:max-content}.admin-side a{display:block;padding:11px 12px;border-radius:9px;color:var(--muted);font-size:13px;font-weight:700}.admin-side a:hover{background:var(--panel2);color:var(--text)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:12px;color:var(--muted);font-weight:800}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:9px;padding:11px 12px;outline:none}.field textarea{min-height:130px;resize:vertical}.toolbar{display:flex;flex-wrap:wrap;gap:6px;border:1px solid var(--line);border-bottom:0;background:var(--panel2);padding:8px;border-radius:9px 9px 0 0}.toolbar button{background:var(--bg);border:1px solid var(--line);color:var(--text);border-radius:6px;padding:7px 9px;cursor:pointer}.editor{min-height:420px;border:1px solid var(--line);background:var(--bg);border-radius:0 0 9px 9px;padding:18px;outline:none;line-height:1.7}.admin-table{width:100%;border-collapse:collapse}.admin-table th,.admin-table td{text-align:left;padding:13px 10px;border-bottom:1px solid var(--line);font-size:12px}.status{font-size:10px;text-transform:uppercase;font-weight:900;padding:5px 7px;border-radius:6px;background:var(--panel2)}.status.published{background:rgba(47,209,122,.1);color:#16834b}.login{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(430px,100%);border:1px solid var(--line);border-radius:20px;background:var(--panel);padding:28px}.cookie-banner{position:fixed;left:18px;right:18px;bottom:18px;z-index:100;display:flex;align-items:center;justify-content:space-between;gap:20px;width:min(900px,calc(100% - 36px));margin:auto;padding:18px 20px;border:1px solid var(--line);border-radius:16px;background:color-mix(in srgb,var(--panel) 94%,transparent);box-shadow:0 18px 60px rgba(0,0,0,.22);backdrop-filter:blur(18px)}.cookie-banner[hidden]{display:none}.cookie-banner p{margin:5px 0 0;color:var(--muted);font-size:12px;line-height:1.5}.cookie-banner a{color:var(--accent);font-weight:800}.cookie-actions{display:flex;gap:8px;flex:none}@media(max-width:620px){.cookie-banner{left:10px;right:10px;bottom:10px;width:auto;display:grid}.cookie-actions{justify-content:flex-end}}@media(max-width:900px){.navlinks{display:none}.menu{display:block}.search{width:170px}.utility-inner{grid-template-columns:1fr}.weather{padding:0 0 10px}.hero-grid{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.admin-grid{grid-template-columns:1fr}.admin-side{display:flex;gap:5px;overflow:auto}.admin-side a{white-space:nowrap}}@media(max-width:620px){.wrap{width:min(calc(100% - 22px),var(--max))}.nav{height:64px;gap:8px}.logo{font-size:22px}.search{width:128px;height:36px}.google-translate{height:36px;padding:0 6px;max-width:118px}.theme-toggle{width:36px;height:36px}.grid{grid-template-columns:1fr}.story-card{grid-template-columns:110px 1fr}.story-card img{min-height:125px}.story-card-body{padding:13px}.story-card h3{font-size:17px}.hero{min-height:430px;border-radius:16px}.hero-content{left:18px;right:18px;bottom:20px}.article-head{padding:35px 0 20px}.article h1{letter-spacing:-2px}.prose{font-size:17px}.footer-grid{display:grid}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.trend-row{grid-template-columns:42px 1fr}.views{display:none}.ticker-label{padding-right:9px;margin-right:9px}.ticker-group{gap:24px;padding-right:24px}.weather{font-size:10px}}
html[data-theme="light"] .theme-toggle .moon{display:none}html[data-theme="light"] .theme-toggle .sun{display:block}html[data-theme="light"] body{background:radial-gradient(circle at 80% -10%,rgba(124,92,255,.08),transparent 32%),radial-gradient(circle at 10% 20%,rgba(255,61,129,.05),transparent 28%),var(--bg)}html[data-theme="light"] .hero{background:var(--panel)}html[data-theme="light"] .hero img{opacity:1;filter:none}html[data-theme="light"] .hero:after{background:linear-gradient(180deg,rgba(0,0,0,.02) 18%,rgba(0,0,0,.22) 48%,rgba(0,0,0,.88) 100%)}html[data-theme="light"] .hero-content{color:#fff}html[data-theme="light"] .hero p{color:rgba(255,255,255,.82)}html[data-theme="light"] .hero .meta{color:rgba(255,255,255,.78)}html[data-theme="light"] .hero .pill{color:#fff;background:rgba(255,61,129,.88)}
</style>
<script is:inline>
(() => {
  const saved = localStorage.getItem("vw-theme");
  const theme = saved === "light" || saved === "dark" ? saved : (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
  document.documentElement.dataset.theme = theme;
})();
</script>
</head>
<body>
<div class="topline"></div>
<header class="header">
  <div class="wrap nav">
    <a class="logo" href={localePath(locale,"/")}>VIRAL<span>WIRE</span></a>
    <nav class="navlinks">
      <a href={localePath(locale,"/")}>{t(Astro.locals,"home")}</a><a href={localePath(locale,"/trending")}>{t(Astro.locals,"trending")}</a><a href={localePath(locale,"/category/x-stories")}>{t(Astro.locals,"xStories")}</a><a href={localePath(locale,"/category/tech-ai")}>{t(Astro.locals,"tech")}</a><a href={localePath(locale,"/category/entertainment")}>{t(Astro.locals,"entertainment")}</a><a href={localePath(locale,"/category/travel")}>Travel</a>
    </nav>
    <form action={localePath(locale,"/search")} method="get"><input class="search" name="q" placeholder={t(Astro.locals,"search")} aria-label={t(Astro.locals,"search")}></form>
    <div id="google_translate_element" class="google-translate" aria-label="Translate this page"></div>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme"><span class="moon">☾</span><span class="sun">☀</span></button>
    <button class="menu" aria-label="Menu">☰</button>
  </div>
  <div class="utility">
    <div class="wrap utility-inner">
      <NewsTicker stories={tickerStories}/>
      <div class="weather" id="weather-widget" aria-live="polite">
        <span class="weather-icon" id="weather-icon">◌</span>
        <div>
          <div class="weather-main"><span id="weather-temp">--°</span> <span class="weather-place" id="weather-place">{t(Astro.locals,"localWeather")}</span></div>
          <div class="weather-meta"><span id="weather-date">Loading date…</span> · <span id="weather-time">--:--</span></div>
        </div>
      </div>
    </div>
  </div>
</header>
<main><slot /></main>
<footer class="footer"><div class="wrap footer-grid"><div><strong style="color:var(--text)">VIRALWIRE</strong><br>{SITE_TAGLINE}</div><div><a href={localePath(locale,"/trending")}>{t(Astro.locals,"trending")}</a> · <a href="/rss.xml">RSS</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/disclaimer">Disclaimer</a> · <a href="/cookies">Cookies</a> · <a href="/admin">Admin</a></div></div></footer>
<div id="cookie-banner" class="cookie-banner" hidden><div><strong>We use cookies</strong><p>VIRALWIRE uses essential cookies for site functions and optional local storage for preferences such as theme and language. See our <a href={localePath(locale,"/cookies")}>Cookie Policy</a>.</p></div><div class="cookie-actions"><button id="cookie-accept" class="btn primary" type="button">Accept</button><button id="cookie-close" class="btn" type="button">Close</button></div></div><script is:inline>
(() => {
  const root=document.documentElement;
  const cookieBanner=document.getElementById("cookie-banner");
  const cookieAccept=document.getElementById("cookie-accept");
  const cookieClose=document.getElementById("cookie-close");
  if(!localStorage.getItem("vw-cookie-consent")) cookieBanner?.removeAttribute("hidden");
  cookieAccept?.addEventListener("click",()=>{localStorage.setItem("vw-cookie-consent","accepted");cookieBanner?.setAttribute("hidden","");});
  cookieClose?.addEventListener("click",()=>{localStorage.setItem("vw-cookie-consent","closed");cookieBanner?.setAttribute("hidden","");});
  const button=document.getElementById("theme-toggle");
  const language=document.getElementById("language-select");
  language?.addEventListener("change",()=>{const value=language.value;const current=location.pathname;const parts=current.split("/").filter(Boolean);const supported=["en","sr","de","es","fr","it","pt"];if(supported.includes(parts[0]))parts.shift();const target=value==="en"?"/"+parts.join("/"):"/"+value+(parts.length?"/"+parts.join("/"):"/");location.href=target+(location.search||"");});
  button?.addEventListener("click",()=>{const next=root.dataset.theme==="light"?"dark":"light";root.dataset.theme=next;localStorage.setItem("vw-theme",next);});
  const temp=document.getElementById("weather-temp");
  const place=document.getElementById("weather-place");
  const icon=document.getElementById("weather-icon");
  const date=document.getElementById("weather-date");
  const time=document.getElementById("weather-time");
  const weatherIcon=(code)=>{
    if(code===0)return"☀️"; if(code<=3)return"⛅"; if(code<=48)return"🌫️"; if(code<=67)return"🌧️"; if(code<=77)return"❄️"; if(code<=82)return"🌦️"; return"⛈️";
  };
  const updateClock=()=>{
    const now=new Date();
    date.textContent=new Intl.DateTimeFormat(undefined,{weekday:"short",day:"2-digit",month:"short",year:"numeric"}).format(now);
    time.textContent=new Intl.DateTimeFormat(undefined,{hour:"2-digit",minute:"2-digit",second:"2-digit"}).format(now);
  };
  updateClock(); setInterval(updateClock,1000);
  const loadWeather=async()=>{
    let lat=44.8125,lon=20.4612,label="Belgrade";
    try{
      const pos=await new Promise((resolve,reject)=>navigator.geolocation?navigator.geolocation.getCurrentPosition(resolve,reject,{timeout:3500,maximumAge:1800000}):reject());
      lat=pos.coords.latitude;lon=pos.coords.longitude;label="Local weather";
    }catch{}
    try{
      const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&timezone=auto`);
      const d=await r.json();
      temp.textContent=Math.round(d.current.temperature_2m)+"°C";
      icon.textContent=weatherIcon(d.current.weather_code);
      place.textContent=label;
    }catch{temp.textContent="--°";place.textContent="Weather unavailable";}
  };
  loadWeather();
})();
</script>
<script is:inline>
window.googleTranslateElementInit=()=>{new google.translate.TranslateElement({pageLanguage:"en",includedLanguages:"af,sq,am,ar,hy,az,eu,be,bn,bs,bg,ca,ceb,ny,zh-CN,zh-TW,co,hr,cs,da,nl,en,eo,et,fi,fr,fy,gl,ka,de,el,gu,ht,ha,haw,iw,he,hi,hmn,hu,is,ig,id,ga,it,ja,jw,kn,kk,km,rw,ko,ku,ky,lo,la,lv,lt,lb,mk,mg,ms,ml,mt,mi,mr,mn,my,ne,no,or,ps,fa,pl,pt,pa,ro,ru,sm,gd,sr,st,si,sk,sl,so,es,su,sw,sv,tg,ta,tt,te,th,tr,tk,uk,ur,ug,uz,vi,cy,xh,yi,yo,zu",autoDisplay:false},"google_translate_element")};
</script>
<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body></html>