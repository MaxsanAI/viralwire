---
import Layout from "../../layouts/Layout.astro";
import Monetag from "../../components/Monetag.astro";
import StoryCard from "../../components/StoryCard.astro";
import {getStoryBySlug,getRelatedStories,incrementViews} from "../../lib/db";
import {formatDate,readingTime,absoluteUrl} from "../../lib/site";
import {getLocale,localePath,t} from "../../lib/i18n";
const slug=Astro.params.slug||"";
const locale=getLocale(Astro.locals);
const story=await getStoryBySlug(Astro.locals,slug);
if(!story)return Astro.redirect("/404");
await incrementViews(Astro.locals,story.id);
const related=await getRelatedStories(Astro.locals,story);
const site=Astro.locals.runtime?.env?.SITE_URL||"https://viralwire.pulserapp.com";
const shareUrl=absoluteUrl(localePath(locale,"/story/"+story.slug),site);
const nextStory=(await getPublishedStoriesForNext(Astro.locals,story.id))[0]||null;
async function getPublishedStoriesForNext(locals:App.Locals,id:number){
  const all=await getRelatedStories(locals,story);
  return all.filter(s=>s.id!==id);
}
---
<Layout title={story.title} description={story.excerpt} image={story.cover_image} canonical={shareUrl}><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"NewsArticle",headline:story.title,description:story.excerpt,image:[absoluteUrl(story.cover_image,site)],datePublished:story.published_at,dateModified:story.published_at,mainEntityOfPage:{"@type":"WebPage","@id":shareUrl},author:{"@type":"Organization",name:"VIRALWIRE",url:site},publisher:{"@type":"Organization",name:"VIRALWIRE",url:site},articleSection:story.category,inLanguage:locale,isAccessibleForFree:true})}></script>
<article class="wrap article">
<header class="article-head">
  <div class="meta"><span class="pill">{story.category}</span><span>{formatDate(story.published_at)}</span><span>{readingTime(story.content)} min read</span><span class="view-count">{Number(story.views||0)+1} {t(Astro.locals,"views")}</span></div>
  <h1>{story.title}</h1>
  <p class="dek">{story.excerpt}</p>
  <div class="sharebar"><a class="btn primary" href={"https://twitter.com/intent/tweet?text="+encodeURIComponent(story.x_post||story.title)+"&url="+encodeURIComponent(shareUrl)} target="_blank" rel="noopener">{t(Astro.locals,"shareX")}</a><button class="btn" id="copy">{t(Astro.locals,"copy")}</button></div>
</header>
<img class="cover" src={story.cover_image} alt={story.title}>
<Monetag />
<div class="prose" set:html={story.content}></div>

{related.length>0 && (
  <section class="inline-read-next">
    <div class="inline-read-next-label">READ NEXT</div>
    <a href={localePath(locale,"/story/"+related[0].slug)}>
      <img src={related[0].cover_image} alt={related[0].title} loading="lazy">
      <div><span class="pill">{related[0].category}</span><h2>{related[0].title}</h2><p>{related[0].excerpt}</p><span class="read-next-link">READ STORY →</span></div>
    </a>
  </section>
)}

{related.length>0 && (
  <section class="section related-section">
    <div class="section-head"><div><div class="eyebrow">KEEP THE FEED MOVING</div><h2>{t(Astro.locals,"more")}</h2></div><a class="btn" href={localePath(locale,"/trending")}>TRENDING NOW</a></div>
    <div class="grid">{related.map(s=><StoryCard story={s}/>)}</div>
  </section>
)}

<section class="retention-newsletter article-newsletter">
  <div class="newsletter-card">
    <div class="newsletter-copy">
      <div class="eyebrow">THE VIRALWIRE DROP</div>
      <h2>Let the next story come to you.</h2>
      <p>Get the biggest viral stories and internet debates in your inbox.</p>
      <span class="newsletter-note">No spam. Just the stories worth knowing.</span>
    </div>
    <form class="newsletter-form" data-newsletter-form>
      <label for="newsletter-email-story">Email address</label>
      <div class="newsletter-input-row">
        <input id="newsletter-email-story" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        <button class="btn primary" type="submit">GET THE DROP</button>
      </div>
      <input class="newsletter-honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="newsletter-status" data-newsletter-status aria-live="polite"></div>
    </form>
  </div>
</section>
</article>
<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
<script>
document.getElementById("copy")?.addEventListener("click",()=>navigator.clipboard.writeText(location.href));
const syncXTheme=()=>{const theme=document.documentElement.dataset.theme==="light"?"light":"dark";document.querySelectorAll(".twitter-tweet").forEach((el)=>el.setAttribute("data-theme",theme));};
syncXTheme();
new MutationObserver(()=>{syncXTheme();}).observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});
window.addEventListener("load",()=>{syncXTheme();window.twttr?.widgets?.load()});
document.querySelectorAll("[data-newsletter-form]").forEach((form)=>{
  form.addEventListener("submit",async(e)=>{
    e.preventDefault();
    const f=form; const button=f.querySelector("button"); const status=f.querySelector("[data-newsletter-status]"); const data=new FormData(f);
    button.disabled=true; button.textContent="JOINING…"; status.textContent="";
    try{
      const r=await fetch("/api/newsletter/subscribe",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:data.get("email"),website:data.get("website")})});
      const j=await r.json(); if(!r.ok) throw new Error(j.error||"Something went wrong.");
      status.textContent=j.message||"You're in. Watch your inbox."; f.reset();
    }catch(err){status.textContent=err instanceof Error?err.message:"Something went wrong. Please try again."}
    finally{button.disabled=false;button.textContent="GET THE DROP";}
  });
});
</script>
<style>
.x-embed{width:100%;max-width:550px;margin:32px auto;display:flex;justify-content:center}
.x-embed .twitter-tweet{margin:0!important;max-width:100%!important}
</style>
</Layout>
