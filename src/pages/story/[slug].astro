---
import Layout from "../../layouts/Layout.astro";
import Monetag from "../../components/Monetag.astro";
import StoryCard from "../../components/StoryCard.astro";
import {getStoryBySlug,getRelatedStories,incrementViews} from "../../lib/db";
import {formatDate,readingTime,absoluteUrl} from "../../lib/site";
import {getLocale,localePath,t} from "../../lib/i18n";
const slug=Astro.params.slug||"";
const locale=getLocale(Astro.locals);
const story=await getStoryBySlug(Astro.locals,slug);
if(!story)return Astro.redirect("/404");
await incrementViews(Astro.locals,story.id);
const related=await getRelatedStories(Astro.locals,story);
const site=Astro.locals.runtime?.env?.SITE_URL||"https://viralwire.pulserapp.com";
const shareUrl=absoluteUrl(localePath(locale,"/story/"+story.slug),site);
---
<Layout title={story.title} description={story.excerpt} image={story.cover_image} canonical={shareUrl}><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"NewsArticle",headline:story.title,description:story.excerpt,image:[absoluteUrl(story.cover_image,site)],datePublished:story.published_at,dateModified:story.published_at,mainEntityOfPage:{"@type":"WebPage","@id":shareUrl},publisher:{"@type":"Organization",name:"VIRALWIRE",url:site}})}></script><article class="wrap article"><header class="article-head"><div class="meta"><span class="pill">{story.category}</span><span>{formatDate(story.published_at)}</span><span>{readingTime(story.content)} min read</span><span class="view-count">{Number(story.views||0)+1} {t(Astro.locals,"views")}</span></div><h1>{story.title}</h1><p class="dek">{story.excerpt}</p><div class="sharebar"><a class="btn primary" href={"https://twitter.com/intent/tweet?text="+encodeURIComponent(story.x_post||story.title)+"&url="+encodeURIComponent(shareUrl)} target="_blank" rel="noopener">{t(Astro.locals,"shareX")}</a><button class="btn" id="copy">{t(Astro.locals,"copy")}</button></div></header><img class="cover" src={story.cover_image} alt={story.title}><Monetag /><div class="prose" set:html={story.content}></div><Monetag />{related.length>0&&<section class="section"><div class="section-head"><div><div class="eyebrow">{t(Astro.locals,"keepReading")}</div><h2>{t(Astro.locals,"more")}</h2></div></div><div class="grid">{related.map(s=><StoryCard story={s}/>)}</div></section>}</article><script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script><script>
document.getElementById("copy")?.addEventListener("click",()=>navigator.clipboard.writeText(location.href));
const syncXTheme=()=>{const theme=document.documentElement.dataset.theme==="light"?"light":"dark";document.querySelectorAll(".twitter-tweet").forEach((el)=>el.setAttribute("data-theme",theme));};
syncXTheme();
new MutationObserver(()=>{syncXTheme();}).observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});
window.addEventListener("load",()=>{syncXTheme();window.twttr?.widgets?.load()});
</script><style>
.x-embed{width:100%;max-width:550px;margin:32px auto;display:flex;justify-content:center}
.x-embed .twitter-tweet{margin:0!important;max-width:100%!important}
</style></Layout>