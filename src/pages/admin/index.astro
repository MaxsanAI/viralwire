---
import Layout from "../../layouts/Layout.astro";
if(Astro.cookies.get("vw_admin")?.value!=="1")return Astro.redirect("/admin/login");
const db=Astro.locals.runtime?.env?.DB; let published=0,drafts=0,views=0,stories:any[]=[];
if(db){try{const r=await db.prepare("SELECT status,COUNT(*) count,COALESCE(SUM(views),0) views FROM stories GROUP BY status").all();for(const x of r.results||[]){if(x.status==="published")published=Number(x.count);if(x.status==="draft")drafts=Number(x.count);views+=Number(x.views||0)}const s=await db.prepare("SELECT id,title,category,status,published_at,views FROM stories ORDER BY datetime(published_at) DESC").all();stories=s.results||[]}catch{}}
---
<Layout title="Vault Control — VIRALWIRE" noindex><div class="admin-shell"><div class="wrap admin-nav"><a class="logo" href="/">VIRAL<span>WIRE</span></a> <span class="muted" style="margin-left:12px">Vault Control</span></div><div class="wrap admin-grid"><aside class="admin-side"><a href="/admin">Dashboard</a><a href="/admin/new">New Story</a><a href="/">View Site</a><a href="/api/admin/logout">Log out</a></aside><section><div class="section-head"><div><div class="eyebrow">CONTROL ROOM</div><h2>Dashboard</h2></div><a class="btn primary" href="/admin/new">+ New Story</a></div><div class="grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:18px"><div class="panel"><div class="muted">Published</div><div style="font-size:32px;font-weight:900">{published}</div></div><div class="panel"><div class="muted">Drafts</div><div style="font-size:32px;font-weight:900">{drafts}</div></div><div class="panel"><div class="muted">Views</div><div style="font-size:32px;font-weight:900">{views.toLocaleString()}</div></div></div>{!db&&<div class="panel" style="margin-bottom:18px"><strong>D1 is not connected.</strong><p class="muted">Add the DB binding and run db/schema.sql in Cloudflare.</p></div>}<div class="panel" style="overflow:auto"><table class="admin-table"><thead><tr><th>Story</th><th>Category</th><th>Status</th><th>Views</th><th></th></tr></thead><tbody>{stories.map(s=><tr><td><strong>{s.title}</strong></td><td>{s.category}</td><td><span class={"status "+s.status}>{s.status}</span></td><td>{Number(s.views||0).toLocaleString()}</td><td><a class="btn" href={"/admin/edit/"+s.id}>Edit</a></td></tr>)}</tbody></table>{db&&!stories.length&&<p class="muted">No stories yet.</p>}</div></section></div></div></Layout>