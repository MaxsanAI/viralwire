---
import Layout from "../../layouts/Layout.astro";
import {categories} from "../../lib/site";
if(Astro.cookies.get("vw_admin")?.value!=="1")return Astro.redirect("/admin/login");
---
<Layout title="New Story — VIRALWIRE" noindex><div class="admin-shell"><div class="wrap admin-nav"><a class="logo" href="/">VIRAL<span>WIRE</span></a> <span class="muted">Vault Control</span></div><div class="wrap admin-grid"><aside class="admin-side"><a href="/admin">Dashboard</a><a href="/admin/new">New Story</a><a href="/">View Site</a><a href="/api/admin/logout">Log out</a></aside><main><div class="section-head"><div><div class="eyebrow">EDITOR</div><h2>New Story</h2></div></div><form class="panel" action="/api/admin/stories" method="post" onsubmit="document.querySelector('#content-input').value=document.querySelector('#editor').innerHTML"><div class="form-grid"><div class="field full"><label>Headline</label><input name="title" required maxlength="180"></div><div class="field"><label>Category</label><select name="category">{categories.map(c=><option>{c}</option>)}</select></div><div class="field"><label>Status</label><select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></div><div class="field full"><label>Excerpt / subtitle</label><textarea name="excerpt" required maxlength="320"></textarea></div><div class="field full"><label>Cover image URL</label><input name="cover_image" type="url" required></div><div class="field full"><label>Tags</label><input name="tags"></div><div class="field full"><label>X post</label><textarea name="x_post"></textarea></div><div class="field full"><label>Article</label><div class="toolbar"><button type="button" onclick="document.execCommand('bold')"><b>B</b></button><button type="button" onclick="document.execCommand('italic')"><i>I</i></button><button type="button" onclick="document.execCommand('formatBlock',false,'h2')">H2</button><button type="button" onclick="document.execCommand('formatBlock',false,'p')">P</button><button type="button" onclick="document.execCommand('formatBlock',false,'blockquote')">Quote</button><button type="button" onclick="document.execCommand('insertUnorderedList')">List</button><button type="button" onclick="document.execCommand('createLink',false,prompt('URL'))">Link</button></div><div id="editor" class="editor" contenteditable="true"><p>Start writing the story here...</p></div><input id="content-input" type="hidden" name="content"></div></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px"><button class="btn" type="submit" name="intent" value="draft">Save Draft</button><button class="btn primary" type="submit" name="intent" value="publish">Publish Story</button></div></form></main></div></div></Layout>