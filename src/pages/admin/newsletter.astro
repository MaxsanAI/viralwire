---
import Layout from "../../layouts/Layout.astro";import {ensureNewsletterTables} from "../../lib/newsletter";import {getPublishedStories} from "../../lib/db";
if(Astro.cookies.get("vw_admin")?.value!=="1")return Astro.redirect("/admin/login");const db=Astro.locals.runtime?.env?.DB;let counts:any={subscribed:0,pending:0,unsubscribed:0};let campaigns:any[]=[];if(db)try{await ensureNewsletterTables(db);const r=await db.prepare("SELECT status,COUNT(*) count FROM newsletter_subscribers GROUP BY status").all<any>();for(const x of r.results||[])counts[x.status]=Number(x.count);const c=await db.prepare("SELECT subject,sent_at,recipient_count FROM newsletter_campaigns ORDER BY id DESC LIMIT 10").all<any>();campaigns=c.results||[]}catch{}const stories=await getPublishedStories(Astro.locals,40);
---
<Layout title="Newsletter — Vault Control" noindex><div class="admin-shell"><div class="wrap admin-nav"><a class="logo" href="/">VIRAL<span>WIRE</span></a> <span class="muted" style="margin-left:12px">Vault Control</span></div><div class="wrap admin-grid"><aside class="admin-side"><a href="/admin">Dashboard</a><a href="/admin/new">New Story</a><a href="/admin/newsletter">Newsletter</a><a href="/">View Site</a><a href="/api/admin/logout">Log out</a></aside><main><div class="section-head"><div><div class="eyebrow">AUDIENCE</div><h2>Newsletter</h2></div></div><div class="grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:18px"><div class="panel"><div class="muted">Confirmed</div><div style="font-size:32px;font-weight:900">{counts.subscribed}</div></div><div class="panel"><div class="muted">Pending</div><div style="font-size:32px;font-weight:900">{counts.pending}</div></div><div class="panel"><div class="muted">Unsubscribed</div><div style="font-size:32px;font-weight:900">{counts.unsubscribed}</div></div></div><form id="newsletter-send" class="panel"><div class="eyebrow">COMPOSE</div><h3 style="font-family:'Space Grotesk';font-size:26px;margin:7px 0 18px">Send a VIRALWIRE Drop</h3><div class="form-grid"><div class="field full"><label>Subject</label><input id="subject" maxlength="180" required placeholder="The stories taking over the internet"></div><div class="field full"><label>Intro</label><textarea id="intro" maxlength="800" placeholder="A short note from VIRALWIRE..."></textarea></div><div class="field full"><label>Stories to include</label><div style="display:grid;gap:9px">{stories.map(s=><label style="display:flex;gap:10px;align-items:flex-start;padding:11px;border:1px solid var(--line);border-radius:10px;background:var(--bg)"><input type="checkbox" name="story" value={s.id}><span><strong>{s.title}</strong><small class="muted" style="display:block;margin-top:3px">{s.category}</small></span></label>)}</div></div></div><div style="display:flex;justify-content:space-between;gap:12px;margin-top:18px;flex-wrap:wrap"><span id="newsletter-send-status" class="muted">Confirmed subscribers only.</span><button class="btn primary" type="submit">SEND NEWSLETTER</button></div></form><section class="section" style="padding-bottom:0"><div class="section-head"><div><div class="eyebrow">HISTORY</div><h2>Recent sends</h2></div></div><div class="panel" style="overflow:auto"><table class="admin-table"><thead><tr><th>Subject</th><th>Sent</th><th>Recipients</th></tr></thead><tbody>{campaigns.map(c=><tr><td><strong>{c.subject}</strong></td><td>{new Date(c.sent_at).toLocaleString()}</td><td>{c.recipient_count}</td></tr>)}</tbody></table></div></section></main></div></div><script>
const form=document.getElementById("newsletter-send");form?.addEventListener("submit",async(e)=>{e.preventDefault();const b=form.querySelector("button"),s=document.getElementById("newsletter-send-status"),ids=[...form.querySelectorAll('input[name="story"]:checked')].map(x=>Number(x.value));b.disabled=true;b.textContent="SENDING…";s.textContent="Sending…";try{const r=await fetch("/api/admin/newsletter/send",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({subject:document.getElementById("subject").value,intro:document.getElementById("intro").value,storyIds:ids})});const raw=await r.text();let j:any={};if(raw.trim()){try{j=JSON.parse(raw)}catch{throw new Error(raw.slice(0,500)||"Server returned an invalid response.")}}if(!r.ok)throw new Error(j.error||"Could not send.");s.textContent=j.message||"Newsletter sent.";form.reset()}catch(e){s.textContent=e instanceof Error?e.message:"Could not send."}finally{b.disabled=false;b.textContent="SEND NEWSLETTER"}});</script></Layout>