---
import Layout from "../../../layouts/Layout.astro";
import AdminImageUpload from "../../../components/AdminImageUpload.astro";
import {categories} from "../../../lib/site";
import {locales,localeNames} from "../../../lib/i18n";
if(Astro.cookies.get("vw_admin")?.value!=="1")return Astro.redirect("/admin/login");
const id=Number(Astro.params.id);const db=Astro.locals.runtime?.env?.DB;const language=String(Astro.url.searchParams.get("lang")||"en");const activeLanguage=locales.includes(language as any)?language:"en";let story:any=null;let translation:any=null;
if(db&&id){try{story=await db.prepare("SELECT * FROM stories WHERE id=?").bind(id).first()}catch{}}
if(!story)return Astro.redirect("/admin");
if(db&&activeLanguage!=="en"){try{translation=await db.prepare("SELECT * FROM story_translations WHERE story_id=? AND language=? LIMIT 1").bind(id,activeLanguage).first()}catch{}}
const data=translation||story;
const previewPath=activeLanguage==="en"?"/story/"+story.slug:"/"+activeLanguage+"/story/"+(translation?.slug||story.slug);
---
<Layout title="Edit Story — VIRALWIRE" noindex><div class="admin-shell"><div class="wrap admin-nav"><a class="logo" href="/">VIRAL<span>WIRE</span></a> <span class="muted">Vault Control</span></div><div class="wrap admin-grid"><aside class="admin-side"><a href="/admin">Dashboard</a><a href="/admin/new">New Story</a><a href="/">View Site</a><a href="/api/admin/logout">Log out</a></aside><main><div class="section-head"><div><div class="eyebrow">EDITOR</div><h2>Edit Story</h2></div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><div class="lang-tabs">{locales.map(code=><a class={"btn "+(code===activeLanguage?"primary":"")} href={"/admin/edit/"+id+"?lang="+code}>{localeNames[code]}</a>)}</div><a class="btn" href={previewPath} target="_blank">Preview ↗</a></div></div><form class="panel" action={"/api/admin/stories/"+id} method="post" onsubmit="document.querySelector('#content-input').value=document.querySelector('#editor').innerHTML"><div class="form-grid"><div class="field full"><label>Headline</label><input type="hidden" name="language" value={activeLanguage}><input name="title" value={data.title} required maxlength="180"></div><div class="field"><label>Category</label><select name="category">{categories.map(c=><option selected={c===story.category}>{c}</option>)}</select></div><div class="field"><label>Status</label><select name="status"><option selected={story.status==="draft"} value="draft">Draft</option><option selected={story.status==="published"} value="published">Published</option></select></div><div class="field full"><label>Excerpt / subtitle</label><textarea name="excerpt" required maxlength="320">{data.excerpt}</textarea></div><div class="field full"><label>Cover image</label><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><input id="cover-image-input" name="cover_image" type="url" value={story.cover_image} required style="flex:1;min-width:260px"><AdminImageUpload target="cover-image-input" label="Upload cover"></AdminImageUpload></div></div><div class="field full"><label>Tags</label><input name="tags" value={data.tags}></div><div class="field full"><label>X post</label><textarea name="x_post">{data.x_post}</textarea></div><div class="field full"><label>Article</label><div class="toolbar"><button type="button" onclick="document.execCommand('bold')"><b>B</b></button><button type="button" onclick="document.execCommand('italic')"><i>I</i></button><button type="button" onclick="document.execCommand('formatBlock',false,'h2')">H2</button><button type="button" onclick="document.execCommand('formatBlock',false,'p')">P</button><button type="button" onclick="document.execCommand('formatBlock',false,'blockquote')">Quote</button><button type="button" onclick="document.execCommand('insertUnorderedList')">List</button><button type="button" onclick="document.execCommand('createLink',false,prompt('URL'))">Link</button></div><div id="editor" class="editor" contenteditable="true" set:html={data.content}></div><AdminImageUpload target="editor" label="Insert image"></AdminImageUpload><input id="content-input" type="hidden" name="content"></div></div><div style="display:flex;justify-content:space-between;gap:10px;margin-top:18px"><button class="btn" type="submit" name="intent" value="delete">Delete</button><div style="display:flex;gap:10px"><button class="btn" type="submit" name="intent" value="draft">Save Draft</button><button class="btn primary" type="submit" name="intent" value="publish">Publish</button></div></div></form></main></div></div></Layout>