---
import Layout from "../layouts/Layout.astro";
import {getLocale,localePath} from "../lib/i18n";

const locale=getLocale(Astro.locals);
---

<Layout title="Contact — VIRALWIRE" description="Get in touch with the VIRALWIRE team.">
  <section class="contact-section">
    <div class="wrap contact-wrap">
      <div class="contact-intro">
        <div class="eyebrow">GET IN TOUCH</div>
        <h1>Have something to say?</h1>
        <p>News tip, story idea, correction, partnership or just want to reach out? Send us a message.</p>
      </div>

      <form class="contact-card" id="contact-form">
        <div class="contact-top">
          <div>
            <div class="contact-kicker">VIRALWIRE CONTACT</div>
            <h2>Send a message</h2>
          </div>
          <div class="contact-badge">DIRECT</div>
        </div>

        <div class="category-row" role="group" aria-label="Message category">
          <button type="button" class="category active" data-category="General">General</button>
          <button type="button" class="category" data-category="News Tip">News Tip</button>
          <button type="button" class="category" data-category="Correction">Correction</button>
          <button type="button" class="category" data-category="Partnership">Partnership</button>
          <button type="button" class="category" data-category="Other">Other</button>
        </div>

        <input type="hidden" name="category" id="contact-category" value="General">

        <div class="contact-grid">
          <label>
            <span>Your name</span>
            <input name="name" type="text" maxlength="100" autocomplete="name" required placeholder="Your name">
          </label>
          <label>
            <span>Your email</span>
            <input name="email" type="email" maxlength="160" autocomplete="email" required placeholder="you@example.com">
          </label>
        </div>

        <label>
          <span>Subject</span>
          <input name="subject" type="text" maxlength="180" required placeholder="What is this about?">
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" maxlength="5000" required placeholder="Write your message..."></textarea>
        </label>

        <input class="contact-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">

        <div class="contact-bottom">
          <div class="contact-note">Your message goes directly to the VIRALWIRE team.</div>
          <button class="send-message" type="submit"><span>Send message</span><span class="send-arrow">↗</span></button>
        </div>
        <div class="contact-status" id="contact-status" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <style>
    .contact-section{padding:72px 0 90px}
    .contact-wrap{display:grid;grid-template-columns:.78fr 1.22fr;gap:46px;align-items:start}
    .contact-intro{padding:34px 0}
    .contact-intro h1{font-family:"Space Grotesk";font-size:clamp(42px,6vw,72px);line-height:.94;letter-spacing:-3px;margin:12px 0 20px;max-width:620px}
    .contact-intro p{font-size:17px;line-height:1.7;color:var(--muted);max-width:500px}
    .contact-card{position:relative;padding:30px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,var(--panel),var(--panel2));box-shadow:0 24px 80px rgba(0,0,0,.18);overflow:hidden}
    .contact-card:before{content:"";position:absolute;width:240px;height:240px;right:-100px;top:-120px;border-radius:50%;background:radial-gradient(circle,rgba(255,61,129,.25),transparent 68%);pointer-events:none}
    .contact-top{position:relative;display:flex;justify-content:space-between;gap:20px;align-items:start;margin-bottom:24px}
    .contact-kicker{font-size:10px;font-weight:900;letter-spacing:1.7px;color:var(--accent)}
    .contact-top h2{font-family:"Space Grotesk";font-size:32px;letter-spacing:-1.2px;margin:7px 0 0}
    .contact-badge{padding:7px 10px;border-radius:8px;background:rgba(255,61,129,.1);border:1px solid rgba(255,61,129,.22);color:#ff75a5;font-size:9px;font-weight:900;letter-spacing:1px}
    .category-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
    .category{border:1px solid var(--line);background:var(--bg);color:var(--muted);border-radius:10px;padding:10px 13px;font-size:11px;font-weight:900;letter-spacing:.2px;cursor:pointer;transition:.18s}
    .category:hover{border-color:#596171;color:var(--text);transform:translateY(-1px)}
    .category.active{border-color:transparent;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;box-shadow:0 8px 22px rgba(124,92,255,.18)}
    .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .contact-card label{display:grid;gap:7px;margin-bottom:14px}
    .contact-card label span{font-size:11px;color:var(--muted);font-weight:900;text-transform:uppercase;letter-spacing:.8px}
    .contact-card input,.contact-card textarea{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:11px;padding:12px 13px;outline:none;transition:.18s}
    .contact-card input{height:45px}
    .contact-card textarea{min-height:170px;resize:vertical;line-height:1.6}
    .contact-card input:focus,.contact-card textarea:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.11)}
    .contact-card input::placeholder,.contact-card textarea::placeholder{color:#707887}
    .contact-bottom{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:5px}
    .contact-note{font-size:11px;color:var(--muted);line-height:1.5}
    .send-message{display:inline-flex;align-items:center;justify-content:center;gap:10px;border:0;border-radius:11px;padding:13px 17px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-size:12px;font-weight:900;letter-spacing:.5px;cursor:pointer;box-shadow:0 10px 28px rgba(124,92,255,.22);transition:.18s}
    .send-message:hover{transform:translateY(-2px);filter:brightness(1.06)}
    .send-message:disabled{opacity:.65;cursor:wait;transform:none}
    .send-arrow{font-size:16px;line-height:1}
    .contact-status{min-height:20px;margin-top:12px;font-size:12px;font-weight:700;color:var(--muted)}
    .contact-status.success{color:#43d58a}
    .contact-status.error{color:#ff6f8f}
    .contact-honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important}
    @media(max-width:820px){.contact-wrap{grid-template-columns:1fr;gap:20px}.contact-intro{padding:10px 0}.contact-intro h1{font-size:clamp(40px,12vw,62px)}}
    @media(max-width:620px){.contact-section{padding:42px 0 65px}.contact-card{padding:20px;border-radius:19px}.contact-grid{grid-template-columns:1fr}.category-row{gap:7px}.category{padding:9px 10px}.contact-bottom{align-items:stretch;flex-direction:column}.send-message{width:100%}}
  </style>

  <script is:inline>
  (() => {
    const form=document.getElementById("contact-form");
    const status=document.getElementById("contact-status");
    const category=document.getElementById("contact-category");
    const buttons=[...document.querySelectorAll(".category")];
    buttons.forEach(button=>button.addEventListener("click",()=>{
      buttons.forEach(b=>b.classList.remove("active"));
      button.classList.add("active");
      category.value=button.dataset.category||"General";
    }));
    form?.addEventListener("submit",async(e)=>{
      e.preventDefault();
      const button=form.querySelector(".send-message");
      button.disabled=true;
      status.className="contact-status";
      status.textContent="Sending…";
      try{
        const payload=Object.fromEntries(new FormData(form).entries());
        const response=await fetch("/api/contact",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
        const data=await response.json().catch(()=>({}));
        if(!response.ok) throw new Error(data.error||"Could not send your message.");
        status.className="contact-status success";
        status.textContent="Message sent. Thanks for reaching out.";
        form.reset();
        category.value="General";
        buttons.forEach(b=>b.classList.toggle("active",b.dataset.category==="General"));
      }catch(error){
        status.className="contact-status error";
        status.textContent=error instanceof Error?error.message:"Could not send your message.";
      }finally{button.disabled=false}
    });
  })();
  </script>
</Layout>
