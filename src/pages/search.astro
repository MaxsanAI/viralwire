---
import Layout from "../layouts/Layout.astro";
import StoryCard from "../components/StoryCard.astro";
import {searchStories} from "../lib/db";
import {getLocale,localePath,t} from "../lib/i18n";
const locale=getLocale(Astro.locals);
const q=Astro.url.searchParams.get("q")||"";
const results=q?await searchStories(Astro.locals,q):[];
---
<Layout title={q? t(Astro.locals,"searchTitle")+": "+q:t(Astro.locals,"searchTitle")} description={t(Astro.locals,"searchDesc")}><section class="wrap section"><div class="eyebrow">SEARCH</div><h1 style="font-family:'Space Grotesk';font-size:52px;letter-spacing:-2px;margin:10px 0 26px">{t(Astro.locals,"searchTitle")}</h1><form action={localePath(locale,"/search")} method="get" style="display:flex;gap:10px;max-width:700px;margin-bottom:32px"><input class="search" style="height:48px;flex:1;width:auto" name="q" value={q} placeholder="Try AI, X, movies, creators..."><button class="btn primary" type="submit">{t(Astro.locals,"searchButton")}</button></form>{q&&<p class="muted">{results.length} result{results.length===1?"":"s"} for “{q}”</p>}<div class="grid" style="margin-top:20px">{results.map(s=><StoryCard story={s}/>)}</div>{q&&!results.length&&<div class="panel"><strong>{t(Astro.locals,"noStories")}</strong><p class="muted">{t(Astro.locals,"tryKeyword")}</p></div>}</section></Layout>