---
import Layout from "../layouts/Layout.astro";
import Monetag from "../components/Monetag.astro";
import {getPublishedStories} from "../lib/db";
import {getLocale,localePath,t} from "../lib/i18n";
const locale=getLocale(Astro.locals);
const stories=(await getPublishedStories(Astro.locals,30)).sort((a,b)=>b.views-a.views);
---
<Layout title={t(Astro.locals,"trending")} description={t(Astro.locals,"trendingDesc")}><section class="wrap section"><div class="eyebrow">VIRALWIRE LIVE FEED</div><h1 style="font-family:'Space Grotesk';font-size:clamp(42px,7vw,76px);letter-spacing:-3px;margin:10px 0 12px">Trending now.</h1><p class="muted" style="max-width:680px;line-height:1.7">{t(Astro.locals,"trendingIntro")}</p><div style="margin-top:28px">{stories.map((s,i)=><a class="trend-row" href={localePath(locale,"/story/"+s.slug)}><div class="rank">{String(i+1).padStart(2,"0")}</div><div><div class="meta"><span class="pill">{s.category}</span></div><h3>{s.title}</h3><p>{s.excerpt}</p></div><div class="views">{s.views.toLocaleString()} {t(Astro.locals,"views")}</div></a>)}</div></section><Monetag /></Layout>