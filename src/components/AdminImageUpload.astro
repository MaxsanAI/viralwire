---
const {target="editor",label="Insert image"}=Astro.props;
---
<div class="image-upload" data-image-upload data-target={target}>
  <input class="image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
  <button type="button" class="btn image-upload-btn" data-upload-button>{label}</button>
  <span class="image-upload-status" data-upload-status></span>
</div>

<script>
  document.querySelectorAll("[data-image-upload]").forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const input = root.querySelector(".image-file");
    const button = root.querySelector("[data-upload-button]");
    const status = root.querySelector("[data-upload-status]");
    const targetId = root.dataset.target || "editor";
    const target = document.getElementById(targetId);

    let savedRange = null;

    const setStatus = (message="", error=false) => {
      if (status instanceof HTMLElement) {
        status.textContent = message;
        status.dataset.error = error ? "1" : "0";
      }
    };

    const selectionBelongsToTarget = (selection) => {
      if (!selection || selection.rangeCount === 0 || !(target instanceof HTMLElement)) return false;
      const range = selection.getRangeAt(0);
      return target.contains(range.commonAncestorContainer);
    };

    const saveSelection = () => {
      const selection = window.getSelection();
      if (selectionBelongsToTarget(selection)) {
        savedRange = selection.getRangeAt(0).cloneRange();
      }
    };

    if (!(input instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement) || !(target instanceof HTMLElement)) return;

    // Save the caret before the file picker takes focus.
    button.addEventListener("mousedown", saveSelection);

    button.addEventListener("click", () => input.click());

    input.addEventListener("change", async () => {
      const file=input.files?.[0];
      if (!file) return;

      if (file.size > 8*1024*1024) {
        setStatus("Image must be 8 MB or smaller.",true);
        input.value="";
        return;
      }

      button.disabled=true;
      setStatus("Uploading…");

      try {
        const form=new FormData();
        form.append("image",file);

        const response=await fetch("/api/admin/upload-image",{method:"POST",body:form});
        const result=await response.json().catch(()=>({}));

        if (!response.ok || !result.url) throw new Error(result.error || "Upload failed.");

        if (target instanceof HTMLInputElement) {
          target.value=result.url;
          target.dispatchEvent(new Event("input",{bubbles:true}));
          target.dispatchEvent(new Event("change",{bubbles:true}));
          setStatus("Cover uploaded.");
        } else {
          const image=document.createElement("img");
          image.src=result.url;
          image.alt=file.name.replace(/\.[^.]+$/,"").replace(/[-_]+/g," ").trim();
          image.loading="lazy";
          image.style.maxWidth="100%";
          image.style.height="auto";

          const figure=document.createElement("figure");
          figure.style.margin="18px 0";
          figure.appendChild(image);

          const range=savedRange && target.contains(savedRange.commonAncestorContainer)
            ? savedRange
            : (() => {
                const fallback=document.createRange();
                fallback.selectNodeContents(target);
                fallback.collapse(false);
                return fallback;
              })();

          range.deleteContents();
          range.insertNode(figure);

          // Put the caret immediately after the inserted image so the next
          // text/image is inserted where the editor user expects it.
          const after=document.createRange();
          after.setStartAfter(figure);
          after.collapse(true);

          const selection=window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(after);

          target.focus();
          target.dispatchEvent(new InputEvent("input",{bubbles:true,inputType:"insertImage",data:null}));

          savedRange=null;
          setStatus("Image inserted.");
        }
      } catch(error) {
        setStatus(error instanceof Error ? error.message : "Upload failed.",true);
      } finally {
        button.disabled=false;
        input.value="";
      }
    });
  });
</script>

<style>
.image-upload{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}
.image-upload-btn{font-size:13px;padding:8px 12px}
.image-upload-status{font-size:12px;color:var(--muted)}
.image-upload-status[data-error="1"]{color:#ff7b8b}
</style>
