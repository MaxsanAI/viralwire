---
const {target="editor"}=Astro.props;
---
<div class="editor-context" data-editor-context data-target={target}>
  <input class="editor-context-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
  <div class="editor-context-menu" data-context-menu hidden>
    <button type="button" data-action="image"><span>▧</span> Insert image</button>
    <button type="button" data-action="x"><span>𝕏</span> Insert X post</button>
    <button type="button" data-action="youtube"><span>▶</span> Insert YouTube</button>
    <button type="button" data-action="widget"><span>&lt;/&gt;</span> Insert widget code</button>
    <button type="button" data-action="paste"><span>T</span> Paste text</button>
  </div>
</div>

<script>
  document.querySelectorAll("[data-editor-context]").forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const targetId = root.dataset.target || "editor";
    const editor = document.getElementById(targetId);
    const menu = root.querySelector("[data-context-menu]");
    const fileInput = root.querySelector(".editor-context-file");
    const imageAction = root.querySelector('[data-action="image"]');
    const xAction = root.querySelector('[data-action="x"]');
    const youtubeAction = root.querySelector('[data-action="youtube"]');
    const widgetAction = root.querySelector('[data-action="widget"]');
    const pasteAction = root.querySelector('[data-action="paste"]');

    let savedRange = null;
    let menuOpen = false;

    if (!(editor instanceof HTMLElement) ||
        !(menu instanceof HTMLElement) ||
        !(fileInput instanceof HTMLInputElement)) return;

    const selectionBelongsToEditor = () => {
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0) return false;
      return editor.contains(selection.getRangeAt(0).commonAncestorContainer);
    };

    const saveSelection = () => {
      const selection = window.getSelection();
      if (selection && selection.rangeCount > 0 && selectionBelongsToEditor()) {
        savedRange = selection.getRangeAt(0).cloneRange();
      }
    };

    const closeMenu = () => {
      menu.hidden = true;
      menuOpen = false;
    };

    const insertAtSavedRange = (node) => {
      const range = savedRange && editor.contains(savedRange.commonAncestorContainer)
        ? savedRange
        : (() => {
            const fallback = document.createRange();
            fallback.selectNodeContents(editor);
            fallback.collapse(false);
            return fallback;
          })();

      range.deleteContents();
      range.insertNode(node);

      const after = document.createRange();
      after.setStartAfter(node);
      after.collapse(true);

      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(after);
      editor.focus();
      savedRange = null;
      editor.dispatchEvent(new InputEvent("input", {
        bubbles: true,
        inputType: "insertText",
        data: null
      }));
    };

    const showMenu = (event) => {
      event.preventDefault();
      saveSelection();

      const width = 210;
      const height = 230;
      const left = Math.min(event.clientX, window.innerWidth - width - 8);
      const top = Math.min(event.clientY, window.innerHeight - height - 8);

      menu.style.left = Math.max(8, left) + "px";
      menu.style.top = Math.max(8, top) + "px";
      menu.hidden = false;
      menuOpen = true;
    };

    editor.addEventListener("contextmenu", showMenu);

    imageAction?.addEventListener("click", () => {
      closeMenu();
      fileInput.click();
    });

    xAction?.addEventListener("click", () => {
      closeMenu();

      const value = window.prompt(
        "Paste an X post URL or the X embed code:",
        ""
      );

      if (!value) return;

      const urlMatch = value.match(
        /https?:\/\/(?:www\.)?(?:x\.com|twitter\.com)\/[^\s"'<>]+\/status\/\d+/i
      );

      if (!urlMatch) {
        alert("Please paste a valid X post URL or X embed code.");
        return;
      }

      const url = urlMatch[0].split("?")[0].split("#")[0];
      const wrap = document.createElement("div");
      wrap.className = "x-embed";
      wrap.style.width = "100%";
      wrap.style.display = "flex";
      wrap.style.justifyContent = "center";
      wrap.innerHTML =
        '<blockquote class="twitter-tweet" data-theme="dark" data-dnt="true"><a href="' +
        url +
        '">' +
        url +
        "</a></blockquote>";

      insertAtSavedRange(wrap);
    });

    youtubeAction?.addEventListener("click", () => {
      closeMenu();

      const value = window.prompt(
        "Paste a YouTube video URL or YouTube embed code:",
        ""
      );

      if (!value) return;

      let videoId = "";
      const embedMatch = value.match(
        /youtube(?:-nocookie)?\.com\/embed\/([A-Za-z0-9_-]{11})/i
      );
      const watchMatch = value.match(
        /(?:youtube\.com\/watch\?[^\s"'<>]*v=|youtu\.be\/)([A-Za-z0-9_-]{11})/i
      );

      if (embedMatch) videoId = embedMatch[1];
      else if (watchMatch) videoId = watchMatch[1];

      if (!videoId) {
        alert("Please paste a valid YouTube URL or YouTube embed code.");
        return;
      }

      const wrap = document.createElement("div");
      wrap.className = "youtube-embed";
      wrap.style.margin = "20px auto";
      wrap.style.position = "relative";
      wrap.style.width = "100%";
      wrap.style.aspectRatio = "16 / 9";
      wrap.style.overflow = "hidden";
      wrap.style.borderRadius = "12px";

      const iframe = document.createElement("iframe");
      iframe.src = "https://www.youtube-nocookie.com/embed/" + videoId;
      iframe.title = "YouTube video";
      iframe.loading = "lazy";
      iframe.allowFullscreen = true;
      iframe.setAttribute(
        "allow",
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      );
      iframe.style.position = "absolute";
      iframe.style.inset = "0";
      iframe.style.width = "100%";
      iframe.style.height = "100%";
      iframe.style.border = "0";

      wrap.appendChild(iframe);
      insertAtSavedRange(wrap);
    });

    widgetAction?.addEventListener("click", () => {
      closeMenu();
      const value = window.prompt("Paste the widget / embed HTML code:", "");
      if (!value) return;
      const wrap = document.createElement("div");
      wrap.className = "widget-embed";
      wrap.style.width = "100%";
      wrap.style.display = "flex";
      wrap.style.justifyContent = "center";
      wrap.style.margin = "24px auto";

      // innerHTML does not execute <script> tags. Build the widget DOM manually
      // and append each script so third-party widgets can initialize in the editor.
      const template = document.createElement("template");
      template.innerHTML = value.trim();
      const fragment = template.content.cloneNode(true);
      const scripts = Array.from(fragment.querySelectorAll("script"));

      scripts.forEach((oldScript) => {
        const script = document.createElement("script");
        for (const attr of Array.from(oldScript.attributes)) {
          script.setAttribute(attr.name, attr.value);
        }
        script.textContent = oldScript.textContent || "";
        oldScript.replaceWith(script);
      });

      wrap.appendChild(fragment);
      insertAtSavedRange(wrap);
    });

    pasteAction?.addEventListener("click", async () => {
      closeMenu();
      try {
        const text = await navigator.clipboard.readText();
        if (!text) return;
        const wrap = document.createElement("div");
        wrap.className = "pasted-text";
        wrap.style.whiteSpace = "pre-wrap";
        wrap.textContent = text;
        insertAtSavedRange(wrap);
      } catch {
        alert("Clipboard access was blocked by the browser. Click inside the article and use Ctrl+V instead.");
      }
    });

    fileInput.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      if (file.size > 8 * 1024 * 1024) {
        alert("Image must be 8 MB or smaller.");
        fileInput.value = "";
        return;
      }

      try {
        const form = new FormData();
        form.append("image", file);

        const response = await fetch("/api/admin/upload-image", {
          method: "POST",
          body: form
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.url) {
          throw new Error(result.error || "Upload failed.");
        }

        const image = document.createElement("img");
        image.src = result.url;
        image.alt = file.name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ").trim();
        image.loading = "lazy";
        image.style.maxWidth = "100%";
        image.style.height = "auto";
        image.style.display = "block";

        const figure = document.createElement("figure");
        figure.style.margin = "18px auto";
        figure.style.width = "100%";
        figure.style.textAlign = "center";
        figure.appendChild(image);

        insertAtSavedRange(figure);
      } catch (error) {
        alert(error instanceof Error ? error.message : "Upload failed.");
      } finally {
        fileInput.value = "";
      }
    });

    document.addEventListener("mousedown", (event) => {
      if (!menuOpen) return;
      if (event.target instanceof Node && menu.contains(event.target)) return;
      closeMenu();
    });

    window.addEventListener("resize", closeMenu);
    window.addEventListener("scroll", closeMenu, true);
  });
</script>

<style>
  .editor-context-menu{
    position:fixed;
    z-index:99999;
    min-width:210px;
    padding:6px;
    border:1px solid var(--line);
    border-radius:12px;
    background:color-mix(in srgb,var(--panel) 96%,transparent);
    box-shadow:0 18px 50px rgba(0,0,0,.22);
    backdrop-filter:blur(14px);
  }
  .editor-context-menu button{
    display:flex;
    align-items:center;
    gap:10px;
    width:100%;
    padding:10px 12px;
    border:0;
    border-radius:8px;
    background:transparent;
    color:inherit;
    font:inherit;
    font-size:13px;
    text-align:left;
    cursor:pointer;
  }
  .editor-context-menu button:hover{
    background:var(--panel2);
  }
  .editor-context-menu button span{
    width:18px;
    text-align:center;
    opacity:.8;
  }
</style>
