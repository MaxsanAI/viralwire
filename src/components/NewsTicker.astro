---
import {getLocale,localePath,t} from "../lib/i18n";
const { stories = [] } = Astro.props;
const locale=getLocale(Astro.locals);
const items = stories.slice(0, 10);
---
{items.length > 0 && (
  <div class="ticker" aria-label={t(Astro.locals,"breaking")}>
    <div class="ticker-label"><span class="live-dot"></span> BREAKING</div>
    <div class="ticker-viewport">
      <div class="ticker-track">
        <div class="ticker-group">
        {items.map((story) => (
          <a href={localePath(locale,`/story/${story.slug}`)} class="ticker-item">
            <span class="ticker-category">{story.category}</span>
            <span>{story.title}</span>
          </a>
        ))}
        {items.map((story) => (
          <a href={`/story/${story.slug}`} class="ticker-item" aria-hidden="true" tabindex="-1">
            <span class="ticker-category">{story.category}</span>
            <span>{story.title}</span>
          </a>
        ))}
        </div>
        <div class="ticker-group" aria-hidden="true">
        {items.map((story) => (
          <a href={localePath(locale,`/story/${story.slug}`)} class="ticker-item" tabindex="-1">
            <span class="ticker-category">{story.category}</span>
            <span>{story.title}</span>
          </a>
        ))}
        </div>
      </div>
    </div>
  </div>
)}
